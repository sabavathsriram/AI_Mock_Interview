# Backend Configuration
BACKEND_PORT=8000
BACKEND_HOST=localhost
BACKEND_DEBUG=True

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ai_mock_interview_db

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Configuration - Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_REQUEST_TIMEOUT=30

# RAG Configuration
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_DIMENSION=384
RAG_CHROMADB_PATH=./data/vector_db
RAG_CHROMADB_COLLECTION_NAME=knowledge_base
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3
RAG_KNOWLEDGE_BASE_DIR=./data/knowledge_base
RAG_MAX_BATCH_SIZE=100
RAG_ENABLE_METADATA_FILTERING=true
RAG_ENABLE_DUPLICATE_DETECTION=true

# Frontend
FRONTEND_PORT=3000
FRONTEND_HOST=localhost
VITE_API_URL=http://localhost:8000/api/v1

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Development
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True

# Feature Flags
ENABLE_EMAIL_NOTIFICATIONS=False
ENABLE_SMS_NOTIFICATIONS=False
ENABLE_ADVANCED_ANALYTICS=False